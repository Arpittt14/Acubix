# Environment Variables — Acubix Technologies
#
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All other variables are server-only.
#
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE
# Obtain from: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous / public key (safe to expose to the browser)
# Used for browser-side auth flows and public queries
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key — SERVER ONLY
# Has full database access and bypasses Row Level Security.
# NEVER expose this to the browser or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE
# Obtain from: Stripe Dashboard → Developers → API Keys
# Use test-mode keys during development (prefix: sk_test_ / pk_test_).
# ─────────────────────────────────────────────────────────────────────────────

# Stripe secret key — SERVER ONLY
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe webhook signing secret — SERVER ONLY
# Obtain from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Stripe publishable key (safe to expose to the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ─────────────────────────────────────────────────────────────────────────────
# RESEND (Transactional Email)
# Obtain from: https://resend.com → API Keys
# ─────────────────────────────────────────────────────────────────────────────

# Resend API key — SERVER ONLY
RESEND_API_KEY=re_your-resend-api-key

# The "From" address used for outbound emails.
# Must be a verified domain in your Resend account.
EMAIL_FROM=Acubix Technologies <hello@yourdomain.com>

# ─────────────────────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────────────────────

# The canonical URL of the site.
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# CONTACT (Optional — public-facing contact information)
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_CONTACT_LINKEDIN=
NEXT_PUBLIC_CONTACT_INSTAGRAM=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Rate Limiting (Upstash Redis)
# ─────────────────────────────────────────────────────────────────────────────

# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
